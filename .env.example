# Default API endpoint baked into the library bundle at build time.
# Required by `pnpm run build` (the lib build fails without it).
# For npm releases this is provided by CI from the ALLOQUI_API_URL repo secret.
VITE_ALLOQUI_API_URL=http://localhost:8000

# Dev harness only (`pnpm run dev`)
VITE_ALLOQUI_PROJECT_KEY=al_dev_test
