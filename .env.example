# Default API endpoint baked into the library bundle at build time.
# Required by `pnpm run build` (the lib build fails without it).
#
# WARNING: do NOT publish a bundle built with the localhost value below — every
# consumer of that release would call their own machine. Releases must go
# through the CI workflow, which injects the ALLOQUI_API_URL repo secret and
# overrides anything in a local .env.
VITE_ALLOQUI_API_URL=http://localhost:8000

# Dev harness only (`pnpm run dev`)
VITE_ALLOQUI_PROJECT_KEY=al_dev_test
