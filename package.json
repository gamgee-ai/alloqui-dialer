{
  "name": "@alloqui/dialer",
  "version": "1.0.0",
  "description": "Drop-in React dialer component for any telephony provider. Firebase for Voice.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/alloqui-react.cjs",
  "module": "./dist/alloqui-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/alloqui-react.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/alloqui-react.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "dialer",
    "voip",
    "twilio",
    "plivo",
    "alloqui",
    "webrtc",
    "telephony",
    "voice"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gamgee-ai/alloqui-dialer"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.lib.ts && cp dist/index.d.ts dist/index.d.cts",
    "build:app": "tsc -b && vite build",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@twilio/voice-sdk": "^2.0.0",
    "lucide-react": "^1.0.0",
    "plivo-browser-sdk": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "sonner": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@twilio/voice-sdk": {
      "optional": true
    },
    "plivo-browser-sdk": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.18.0",
      "tar": ">=7.5.21",
      "fast-uri": ">=3.1.5",
      "postcss": ">=8.5.23",
      "form-data": ">=4.0.6",
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.17",
      "@babel/core": ">=7.29.6",
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@2": ">=2.1.4 <3",
      "brace-expansion@5": ">=5.0.9",
      "uuid": ">=11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@twilio/voice-sdk": "^2.18.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "lucide-react": "^1.30.0",
    "plivo-browser-sdk": "^2.2.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
