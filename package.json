{
  "name": "@alloqui/dialer",
  "version": "1.0.0",
  "description": "Drop-in React dialer component for any telephony provider. Firebase for Voice.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/alloqui-react.cjs",
  "module": "./dist/alloqui-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/alloqui-react.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/alloqui-react.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "dialer",
    "voip",
    "twilio",
    "plivo",
    "alloqui",
    "webrtc",
    "telephony",
    "voice"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gamgee-ai/alloqui-dialer"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.lib.ts && cp dist/index.d.ts dist/index.d.cts",
    "build:app": "tsc -b && vite build",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@twilio/voice-sdk": "^2.0.0",
    "lucide-react": "^1.0.0",
    "plivo-browser-sdk": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "sonner": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@twilio/voice-sdk": {
      "optional": true
    },
    "plivo-browser-sdk": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.16.0",
      "tar": ">=7.5.15",
      "fast-uri": ">=3.1.2",
      "postcss": ">=8.5.14"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@twilio/voice-sdk": "^2.12.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "lucide-react": "^1.7.0",
    "plivo-browser-sdk": "^2.2.21",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^4.5.0"
  }
}
